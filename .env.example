# AI Peer Review - Environment Variables (local models)
# Copy this file to .env and adjust to point at your local inference server.
#
# No third-party LLM API keys are used. Every reviewer and the meta-reviewer
# are served by an OpenAI-compatible local server you run yourself
# (Ollama, LM Studio, llama.cpp, vLLM, LocalAI, ...), so the manuscript
# text never leaves a machine you control.

# Default base URL of the local OpenAI-compatible server.
# Ollama:      http://localhost:11434/v1
# LM Studio:   http://localhost:1234/v1
# llama.cpp:   http://localhost:8080/v1
# vLLM:        http://localhost:8000/v1
AI_PEER_REVIEW_BASE_URL=http://localhost:11434/v1

# Placeholder "API key". Local servers ignore it, but the OpenAI Python SDK
# requires a non-empty string. Leave as "local" unless your server enforces
# a real key (rare).
AI_PEER_REVIEW_API_KEY=local

# Optional: path to a custom config JSON (otherwise ~/.ai-peer-review/config.json).
# AI_PEER_REVIEW_CONFIG_FILE=/path/to/config.json
